# Copy to .env and fill in. Never commit the real .env file.

# --- Core ---
LOOKUP_CLI_CACHE_DB_PATH=~/.lookup-cli/cache.sqlite3
LOOKUP_CLI_CACHE_TTL_SECONDS=3600

# --- Okta (Stage 2) ---
OKTA_ORG_URL=https://your-org.okta.com
OKTA_API_TOKEN=

# --- Jira (Stage 3) ---
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# --- Jamf (Stage 4) ---
# Not yet available -- runs in mock mode until credentials are provisioned.
LOOKUP_CLI_MOCK_JAMF=1
JAMF_BASE_URL=
JAMF_CLIENT_ID=
JAMF_CLIENT_SECRET=

# --- ABM (Stage 5) ---
# Not yet available -- runs in mock mode until credentials are provisioned.
# NOTE: confirm auth flow before Stage 5 starts (Apple Business Manager API
# server token vs. MDM-vendor-brokered access) -- see docs/STAGES.md.
LOOKUP_CLI_MOCK_ABM=1
ABM_CLIENT_ID=
ABM_KEY_ID=
ABM_PRIVATE_KEY_PATH=

# --- allwhere (Stage 6) ---
# Not yet available -- runs in mock mode until credentials are provisioned.
LOOKUP_CLI_MOCK_ALLWHERE=1
ALLWHERE_API_KEY=
